theory Signal
begin

builtins: diffie-hellman, symmetric-encryption
functions: kdf/1, decrypts/2, true/0
equations: decrypts(senc(m, k), k) = true

heuristic: O "signal.py"

restriction Eq:
  "All a b #x. Eq(a, b) @ #x ==> a = b"

restriction Neq:
  "All a b #x. Neq(a, b) @ #x ==> not (a = b)"

rule KeyGen:
  [ Fr(~ltk), Fr(~prek) ]
  -->
  [ !SecretKeys($A, ~ltk, ~prek)
  , !PublicKeys($A, 'g'^~ltk, 'g'^~prek)
  , Out('g'^~ltk)
  , Out('g'^~prek) ]

rule LtkReveal:
  [ !SecretKeys($A, sk1, sk2) ]
  --[ LtkReveal($A) ]->
  [ Out(sk1), Out(sk2) ]

rule SenderStart:
  let dh1 = prepk^~ltk
      dh2 = ltpk^~x
      dh3 = prepk^~x
      ss = kdf(<dh1, dh2, dh3>)
      rk = kdf(<'rk', ss>)
      ck = kdf(<'ck', ss>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~id), Fr(~x), Fr(~m)
  , !SecretKeys($A, ~ltk, prek)
  , !PublicKeys($B, ltpk, prepk) ]
  --[ Neq($A, $B)
    , RootKey(~id, $A, $B, rk)
    , NewRootKey(~id, $A, $B, rk)
    , Send(~m, $A, $B) ]->
  [ Session(~id, $A, 'S', ~x, $B, prepk, rk, ck)
  , Out(<'g'^~x, senc(~m, mk)>) ]

rule Send:
  let new_ck = kdf(<'ck', ck>)
      mk = kdf(<'mk', new_ck>)
  in
  [ Fr(~m)
  , Session(~id, $A, 'S', ~x, $B, pc, rk, ck) ]
  --[ Send(~m, $A, $B)
    , RootKey(~id, $A, $B, rk)
    , ChainKey(~id, new_ck) ]->
  [ Session(~id, $A, 'S', ~x, $B, pc, rk, new_ck)
  , Out(senc(~m, mk)) ]

rule ReceiverStart:
  let dh1 = ltpk^~prek
      dh2 = pc^~ltk
      dh3 = pc^~prek
      ss = kdf(<dh1, dh2, dh3>)
      rk = kdf(<'rk', ss>)
      ck = kdf(<'ck', ss>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~id)
  , !SecretKeys($A, ~ltk, ~prek)
  , !PublicKeys($B, ltpk, prepk)
  , In(<pc, enc>) ]
  --[ Neq($A, $B)
    , RootKey(~id, $A, $B, rk)
    , NewRootKey(~id, $A, $B, rk)
    , Receive(sdec(enc, mk), $A, $B)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~prek, $B, pc, rk, ck) ]

rule Receive:
  let new_ck = kdf(<'ck', ck>)
      mk = kdf(<'mk', new_ck>)
  in
  [ In(enc)
  , Session(~id, $A, 'R', ~x, $B, pc, rk, ck) ]
  --[ RootKey(~id, $A, $B, rk)
    , Receive(sdec(enc, mk), $A, $B)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~x, $B, pc, rk, new_ck) ]

rule OuterRatchetToSender:
  let dhss = pc^~x
      rk = kdf(<'rk', old_rk, dhss>)
      ck = kdf(<'ck', old_rk, dhss>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~x), Fr(~m)
  , Session(~id, $A, 'R', drop, $B, pc, old_rk, old_ck) ]
  --[ RootKey(~id, $A, $B, rk)
    , NewRootKey(~id, $A, $B, rk)
    , Send(~m, $A, $B) ]->
  [ Session(~id, $A, 'S', ~x, $B, pc, rk, ck)
  , Out(<'g'^~x, senc(~m, mk)>) ]

rule OuterRatchetToReceiver:
  let dhss = pc^~x
      rk = kdf(<'rk', old_rk, dhss>)
      ck = kdf(<'ck', old_rk, dhss>)
      mk = kdf(<'mk', ck>)
  in
  [ In(<pc, enc>)
  , Session(~id, $A, 'S', ~x, $B, old_pc, old_rk, old_ck) ]
  --[ Receive(sdec(enc, mk), $A, $B)
    , RootKey(~id, $A, $B, rk)
    , NewRootKey(~id, $A, $B, rk)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~x, $B, pc, rk, ck) ]

lemma Exec:
  exists-trace
  "Ex id1 id2 m a b rk #x #y.
      Receive(m, b, a) @ #x & RootKey(id1, b, a, rk) @ #x
    & Send(m, a, b) @ #y & RootKey(id2, a, b, rk) @ #y"
simplify
solve( Receive( m, b, a ) @ #x )
  case OuterRatchetToReceiver
  solve( Session( ~id, $A, 'S', ~x.1, $B, old_pc, old_rk, old_ck
         ) ▶₁ #x )
    case OuterRatchetToSender
    by sorry
  next
    case Send
    solve( Session( ~id, $A, 'S', ~x.1, $B, old_pc, old_rk, ck
           ) ▶₁ #vr )
      case OuterRatchetToSender
      by sorry
    next
      case Send
      by sorry
    next
      case SenderStart
      solve( Send( z.1, $B, $A ) @ #y )
        case OuterRatchetToSender
        solve( Session( ~id.1, $A.1, 'R', drop, $B.1, pc.1, old_rk.1,
                        old_ck.1
               ) ▶₂ #y )
          case OuterRatchetToReceiver_case_1
          by sorry
        next
          case OuterRatchetToReceiver_case_2
          by sorry
        next
          case OuterRatchetToReceiver_case_3
          by sorry
        next
          case Receive
          solve( Session( ~id.1, $A.1, 'R', ~x.13, $B.1, pc.1, old_rk.1, ck.1
                 ) ▶₁ #vr.4 )
            case OuterRatchetToReceiver_case_1
            by sorry
          next
            case OuterRatchetToReceiver_case_2
            by sorry
          next
            case OuterRatchetToReceiver_case_3
            by sorry
          next
            case Receive
            by sorry
          next
            case ReceiverStart
            solve( RootKey( id1, $B.1, $A.1, rk ) @ #x )
              case OuterRatchetToReceiver
              solve( RootKey( id2, $A.1, $B.1,
                              kdf(<'rk',
                                   kdf(<'rk',
                                        kdf(<'g'^(~ltk*~prek.1), 'g'^(~ltk.1*~x.1),
                                             'g'^(~prek.1*~x.1)>)
                                       >),
                                   z>)
                     ) @ #y )
                case OuterRatchetToSender
                solve( !KU( senc(z.4,
                                 kdf(<'mk',
                                      kdf(<'ck',
                                           kdf(<'ck',
                                                kdf(<'g'^(~prek.3*~ltk.4), 'g'^(~ltk.1*~x.20),
                                                     'g'^(~prek.3*~x.20)>)
                                               >)
                                          >)
                                     >))
                       ) @ #vk.3 )
                  case Send
                  solve( !KU( senc(x.14,
                                   kdf(<'mk',
                                        kdf(<'ck',
                                             kdf(<'g'^(~prek.3*~ltk.4), 'g'^(~ltk.1*~x.20),
                                                  'g'^(~prek.3*~x.20)>)
                                            >)
                                       >))
                         ) @ #vk.6 )
                    case Send
                    solve( Session( ~id.2, $A.2, 'S', ~x.25, $B.2, pc.2, rk.1,
                                    kdf(<'ck',
                                         kdf(<'g'^(~prek.3*~ltk.4), 'g'^(~ltk.1*~x.20),
                                              'g'^(~prek.3*~x.20)>)
                                        >)
                           ) ▶₁ #vr.8 )
                      case Send
                      by sorry
                    next
                      case SenderStart
                      by sorry
                    qed
                  next
                    case SenderStart
                    solve( Session( ~id.2, $A.2, 'S', ~x.25, $B.2, pc.2, rk.1,
                                    kdf(<'ck',
                                         kdf(<'g'^(~prek.4*~ltk.5), 'g'^(~ltk.6*~x.26),
                                              'g'^(~prek.4*~x.26)>)
                                        >)
                           ) ▶₁ #vr.8 )
                      case Send
                      by sorry
                    next
                      case SenderStart
                      solve( !KU( senc(~m.3,
                                       kdf(<'mk',
                                            kdf(<'ck',
                                                 kdf(<'rk',
                                                      kdf(<'g'^(~ltk.7*~prek.7),
                                                           'g'^(~ltk.8*~x.27), 'g'^(~prek.7*~x.27)>)
                                                     >),
                                                 'g'^(~x.21*~x.27)>)
                                           >))
                             ) @ #vk.2 )
                        case OuterRatchetToSender
                        solve( !KU( 'g'^~x.28 ) @ #vk.1 )
                          case OuterRatchetToSender
                          solve( !KU( 'g'^~x.27 ) @ #vk.5 )
                            case SenderStart
                            SOLVED // trace found
                          next
                            case c_exp
                            by sorry
                          qed
                        next
                          case c_exp
                          by sorry
                        qed
                      next
                        case c_senc
                        by sorry
                      qed
                    qed
                  next
                    case c_senc
                    by sorry
                  qed
                next
                  case c_senc
                  by sorry
                qed
              qed
            qed
          qed
        next
          case ReceiverStart
          by sorry
        qed
      next
        case Send
        by sorry
      next
        case SenderStart
        by sorry
      qed
    qed
  next
    case SenderStart
    by sorry
  qed
next
  case Receive
  by sorry
next
  case ReceiverStart
  by sorry
qed

lemma Auto_OuterLoopStep[reuse,use_induction]:
  "All id a b rk #a. RootKey(id, a, b, rk) @ #a & not NewRootKey(id, a, b, rk) @ #a
    ==> Ex #b. NewRootKey(id, a, b, rk) @ #b & b < #a"

// NOTE: <...> is right-associative. In the outer ratchet, we use two values to
// derive a new root key, but ss will be unified with both.
lemma Auto_RkSecrecy[reuse,use_induction]:
  "All id a b ss #t. RootKey(id, a, b, kdf(<'rk', ss>)) @ #t
  ==>   (not Ex #x. KU(ss) @ #x)
      | (Ex #x. LtkReveal(a) @ #x)
      | (Ex #x. LtkReveal(b) @ #x)"

lemma Auto_CkSecrecy[reuse,use_induction,hide_lemma=OuterLoopStep,hide_lemma=RkSecrecy]:
  "All id a b rk ck #a. ChainKey(id, ck) @ #a & RootKey(id, a, b, rk) @ #a
    ==>   (not Ex #x. KU(ck) @ #x)
        | (Ex ss #x. rk = kdf(<'rk', ss>) & KU(ss) @ #x)"

lemma Auto_Secrecy[no_cyclic,hide_lemma=OuterLoopStep]:
  "All m a b #t.
        Send(m, a, b) @ #t
    ==>   (not Ex #x. K(m) @ #x)
        | (Ex #x. LtkReveal(a) @ #x)
        | (Ex #x. LtkReveal(b) @ #x)"

end
