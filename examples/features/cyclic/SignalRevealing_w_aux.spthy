theory SignalRevealingWAux
begin

tactic: noeqs
presort: i

deprio: regex "Session\(.+#x\.1"
deprio: regex "splitEqs"

heuristic: {noeqs}

builtins: diffie-hellman, symmetric-encryption
functions: kdf/1, decrypts/2, true/0
equations: decrypts(senc(m, k), k) = true

// heuristic: O "signal-revealing.py"

restriction Eq:
  "All a b #x. Eq(a, b) @ #x ==> a = b"

restriction Neq:
  "All a b #x. Neq(a, b) @ #x ==> not (a = b)"

rule KeyGen:
  [ Fr(~ltk), Fr(~prek) ]
  -->
  [ !SecretKeys($A, ~ltk, ~prek)
  , !PublicKeys($A, 'g'^~ltk, 'g'^~prek)
  , Out('g'^~ltk)
  , Out('g'^~prek) ]

rule RevealLtk:
  [ !SecretKeys($A, ~ltk, ~prek) ]
  --[ Reveal('g'^~ltk) ]->
  [ Out(~ltk) ]

rule RevealPrek:
  [ !SecretKeys($A, ~ltk, ~prek) ]
  --[ Reveal('g'^~prek) ]->
  [ Out(~prek) ]

rule RevealEphemeral:
  [ !EphemeralDH($A, ~x) ]
  --[ Reveal('g'^~x) ]->
  [ Out(~x) ]

rule SenderStart:
  let dh1 = prepk^~ltk
      dh2 = ltpk^~x
      dh3 = prepk^~x
      ss = kdf(<dh1, dh2, dh3>)
      rk = kdf(<'rk', ss>)
      ck = kdf(<'ck', rk>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~id), Fr(~x), Fr(~m)
  , !SecretKeys($A, ~ltk, prek)
  , !PublicKeys($B, ltpk, prepk) ]
  --[ Neq($A, $B)
    , ToSender(~id, 'g'^~x, dh3)
    , Send(~id, ~m, 'g'^~x, prepk, prepk^~x)
    , GenEph('g'^~x) ]->
  [ !EphemeralDH($A, ~x)
  , Session(~id, $A, 'S', ~x, $B, prepk, rk, ck)
  , Out(<'g'^~x, senc(~m, mk)>) ]

rule Send:
  let new_ck = kdf(<'ck', ck>)
      mk = kdf(<'mk', new_ck>)
  in
  [ Fr(~m)
  , Session(~id, $A, 'S', ~x, $B, pc, rk, ck) ]
  --[ Send(~id, ~m, 'g'^~x, pc, pc^~x)
    , ChainKey(~id, new_ck) ]->
  [ Session(~id, $A, 'S', ~x, $B, pc, rk, new_ck)
  , Out(senc(~m, mk)) ]

rule ReceiverStart:
  let dh1 = ltpk^~prek
      dh2 = pc^~ltk
      dh3 = pc^~prek
      ss = kdf(<dh1, dh2, dh3>)
      rk = kdf(<'rk', ss>)
      ck = kdf(<'ck', rk>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~id)
  , !SecretKeys($A, ~ltk, ~prek)
  , !PublicKeys($B, ltpk, prepk)
  , In(<pc, enc>) ]
  --[ Neq($A, $B)
    , Neq(pc, DH_neutral)
    , ToReceiver(~id, 'g'^~prek)
    , Receive(~id, sdec(enc, mk), 'g'^~prek, pc)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~prek, $B, pc, rk, ck) ]

rule Receive:
  let new_ck = kdf(<'ck', ck>)
      mk = kdf(<'mk', new_ck>)
  in
  [ In(enc)
  , Session(~id, $A, 'R', ~x, $B, pc, rk, ck) ]
  --[ Receive(~id, sdec(enc, mk), 'g'^~x, pc)
    , Use(~id, 'g'^~x)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~x, $B, pc, rk, new_ck) ]

rule OuterRatchetToSender:
  let dhss = pc^~x
      rk = kdf(<'rk', old_rk, dhss>)
      ck = kdf(<'ck', rk>)
      mk = kdf(<'mk', ck>)
  in
  [ Fr(~x), Fr(~m)
  , Session(~id, $A, 'R', drop, $B, pc, old_rk, old_ck) ]
  --[ ToSender(~id, 'g'^~x, dhss)
    , Send(~id, ~m, 'g'^~x, pc, dhss)
    , GenEph('g'^~x)  ]->
  [ !EphemeralDH($A, ~x)
  , Session(~id, $A, 'S', ~x, $B, pc, rk, ck)
  , Out(<'g'^~x, senc(~m, mk)>) ]

rule OuterRatchetToReceiver:
  let dhss = pc^~x
      rk = kdf(<'rk', old_rk, dhss>)
      ck = kdf(<'ck', rk>)
      mk = kdf(<'mk', ck>)
  in
  [ In(<pc, enc>)
  , Session(~id, $A, 'S', ~x, $B, old_pc, old_rk, old_ck) ]
  --[ Neq(pc, DH_neutral)
    , ToReceiver(~id, 'g'^~x)
    , Receive(~id, sdec(enc, mk), 'g'^~x, pc)
    , Eq(decrypts(enc, mk), true) ]->
  [ Session(~id, $A, 'R', ~x, $B, pc, rk, ck) ]

lemma Exec:
  exists-trace
  "Ex id1 id2 m pc1 pc2 ss #x #y. Receive(id1, m, pc1, pc2) @ #x
    & Send(id2, m, pc2, pc1, ss) @ #y"

lemma OuterLoopStepSender:
  "All id m pc x ss #a. Send(id, m, pc, x, ss) @ #a & not ToSender(id, pc, ss) @ #a
    ==> Ex #b. ToSender(id, pc, ss) @ #b & b < #a"
simplify
solve( Send( id, m, pc, x, ss ) @ #a )
  case OuterRatchetToSender
  by contradiction /* from formulas */
next
  case Send
  solve( Session( ~id.1, $A, 'S', ~x.1, $B, pc.1, rk, ck ) ▶₁ #a )
    case OuterRatchetToSender_case_1
    solve( splitEqs(0) )
      case split_case_1
      by contradiction /* from formulas */
    next
      case split_case_2
      by contradiction /* from formulas */
    next
      case split_case_3
      by contradiction /* from formulas */
    next
      case split_case_4
      by contradiction /* from formulas */
    next
      case split_case_5
      by contradiction /* from formulas */
    next
      case split_case_6
      by contradiction /* from formulas */
    next
      case split_case_7
      by contradiction /* from formulas */
    qed
  next
    case OuterRatchetToSender_case_2
    solve( splitEqs(0) )
      case split_case_1
      by contradiction /* from formulas */
    next
      case split_case_2
      by contradiction /* from formulas */
    next
      case split_case_3
      by contradiction /* from formulas */
    next
      case split_case_4
      by contradiction /* from formulas */
    next
      case split_case_5
      by contradiction /* from formulas */
    next
      case split_case_6
      by contradiction /* from formulas */
    next
      case split_case_7
      by contradiction /* from formulas */
    qed
  next
    case OuterRatchetToSender_case_3
    solve( splitEqs(0) )
      case split_case_1
      by contradiction /* from formulas */
    next
      case split_case_2
      by contradiction /* from formulas */
    next
      case split_case_3
      by contradiction /* from formulas */
    next
      case split_case_4
      by contradiction /* from formulas */
    next
      case split_case_5
      by contradiction /* from formulas */
    next
      case split_case_6
      by contradiction /* from formulas */
    next
      case split_case_7
      by contradiction /* from formulas */
    qed
  next
    case Send
    search for cycle
    cut( ∀ #b. (ToSender( ~id.1, 'g'^~x.1, z.1 ) @ #b) ⇒ ¬(#b < #vr) )
      case cut
      by contradiction /* cyclic backlink to CS id 4-04 */
    next
      case negate_0
      solve( splitEqs(0) )
        case split_case_1
        by contradiction /* from formulas */
      next
        case split_case_2
        by contradiction /* from formulas */
      next
        case split_case_3
        by contradiction /* from formulas */
      next
        case split_case_4
        by contradiction /* from formulas */
      next
        case split_case_5
        by contradiction /* from formulas */
      next
        case split_case_6
        by contradiction /* from formulas */
      next
        case split_case_7
        by contradiction /* from formulas */
      qed
    qed
  next
    case SenderStart
    by contradiction /* from formulas */
  qed
next
  case SenderStart
  by contradiction /* from formulas */
qed

lemma SSSecrecy:
  "All id m pc1 pc2 ss #t. Send(id, m, pc1, pc2, ss) @ #t
  ==>   (not Ex #x. KU(ss) @ #x)
      | (Ex #x. Reveal(pc1) @ #x)
      | (Ex #x. Reveal(pc2) @ #x)
      | (not Ex #x. GenEph(pc2) @ #x)"
simplify
solve( GenEph( pc2 ) @ #x.1 )
  case OuterRatchetToSender
  solve( Send( id, m, pc1, 'g'^~x.2, ss ) @ #t )
    case OuterRatchetToSender
    solve( !KU( 'g'^(~x.4*~x.5) ) @ #x )
      case OuterRatchetToSender_case_1
      solve( !KU( ~x.10 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_2
      solve( !KU( ~x.7 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_3
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_4
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_5
      solve( !KU( ~x.12 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_6
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case c_exp
      solve( !KU( ~x.4 ) @ #vk.2 )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    qed
  next
    case Send
    solve( Session( ~id.2, $A.1, 'S', ~x.5, $B.1, 'g'^~x.4, rk, ck
           ) ▶₁ #t )
      case OuterRatchetToSender_case_1
      solve( !KU( 'g'^(~x.6*~x.7) ) @ #x )
        case OuterRatchetToSender_case_1
        solve( !KU( ~x.10 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_2
        solve( !KU( ~x.10 ) @ #vk.3 )
          case RevealEphemeral_case_1
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_2
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_3
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_3
        solve( !KU( ~x.11 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_4
        solve( !KU( ~x.11 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case c_exp
        solve( !KU( ~x.6 ) @ #vk.5 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      qed
    next
      case OuterRatchetToSender_case_2
      solve( !KU( 'g'^(~x.6*~x.8) ) @ #x )
        case OuterRatchetToSender_case_1
        solve( !KU( ~x.10 ) @ #vk.1 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_2
        solve( !KU( ~x.11 ) @ #vk.1 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_3
        solve( !KU( ~x.11 ) @ #vk.1 )
          case RevealEphemeral_case_1
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_2
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_3
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_4
        solve( !KU( ~x.11 ) @ #vk.1 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case c_exp
        solve( !KU( ~x.6 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      qed
    next
      case OuterRatchetToSender_case_3
      solve( !KU( 'g'^(~x.6*~x.8) ) @ #x )
        case OuterRatchetToSender_case_1
        solve( !KU( ~x.11 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_2
        solve( !KU( ~x.12 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_3
        solve( !KU( ~x.12 ) @ #vk.3 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_4
        solve( !KU( ~x.12 ) @ #vk.3 )
          case RevealEphemeral_case_1
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_2
          by contradiction /* from formulas */
        next
          case RevealEphemeral_case_3
          by contradiction /* from formulas */
        qed
      next
        case c_exp
        solve( !KU( ~x.6 ) @ #vk.5 )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      qed
    next
      case Send
      search for cycle
      by contradiction /* cyclic backlink to CS id 5-0c */
    qed
  next
    case SenderStart
    solve( !KU( 'g'^(~x.2*~x.3) ) @ #x )
      case OuterRatchetToSender_case_1
      by solve( !KU( ~x.16 ) @ #vk )
    next
      case OuterRatchetToSender_case_2
      by solve( !KU( ~x.17 ) @ #vk )
    next
      case OuterRatchetToSender_case_3
      by solve( !KU( ~x.17 ) @ #vk )
    next
      case c_exp
      solve( !KU( ~x.2 ) @ #vk.2 )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    qed
  qed
next
  case SenderStart
  solve( Send( id, m, pc1, 'g'^~x.2, ss ) @ #t )
    case OuterRatchetToSender
    solve( !KU( 'g'^(~x.4*~x.5) ) @ #x )
      case OuterRatchetToSender_case_1
      solve( !KU( ~x.10 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_2
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_3
      solve( !KU( ~x.12 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case SenderStart
      solve( !KU( ~x.7 ) @ #vk )
        case RevealEphemeral_case_1
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_2
        by contradiction /* from formulas */
      next
        case RevealEphemeral_case_3
        by contradiction /* from formulas */
      qed
    next
      case c_exp
      solve( !KU( ~x.4 ) @ #vk.2 )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    qed
  next
    case Send
    solve( !KU( 'g'^(~x.4*~x.5) ) @ #x )
      case KeyGen_case_1
      solve( !KU( ~x.6 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case KeyGen_case_2
      solve( !KU( ~x.6 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_1
      solve( !KU( ~x.7 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_2
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case OuterRatchetToSender_case_3
      solve( !KU( ~x.8 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case SenderStart_case_1
      solve( !KU( ~x.7 ) @ #vk )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    next
      case SenderStart_case_2
      solve( Session( ~id.2, $A.1, 'S', ~x.7, $B.1, 'g'^~x.6, rk, ck
             ) ▶₁ #t )
        case OuterRatchetToSender_case_1
        solve( !KU( ~x.8 ) @ #vk )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_2
        solve( !KU( ~x.8 ) @ #vk )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case OuterRatchetToSender_case_3
        solve( !KU( ~x.8 ) @ #vk )
          case RevealEphemeral
          by contradiction /* from formulas */
        qed
      next
        case Send
        search for cycle
        by contradiction /* cyclic backlink to CS id 8-68 */
      qed
    next
      case c_exp
      solve( !KU( ~x.4 ) @ #vk.2 )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    qed
  next
    case SenderStart
    solve( !KU( 'g'^(~x.2*~x.3) ) @ #x )
      case SenderStart
      by solve( !KU( ~x.17 ) @ #vk )
    next
      case c_exp
      solve( !KU( ~x.2 ) @ #vk.2 )
        case RevealEphemeral
        by contradiction /* from formulas */
      qed
    qed
  qed
qed

lemma CkSecrecy:
  "All id m pc1 pc2 ss ck #a. ChainKey(id, ck) @ #a & Send(id, m, pc1, pc2, ss) @ #a
    ==>   (not Ex #x. KU(ck) @ #x)
        | (Ex #x. KU(ss) @ #x)"
simplify
solve( Send( ~id.1, m, pc1, pc2, ss ) @ #a )
  case Send
  solve( !KU( kdf(<'ck', ck.1>) ) @ #x )
    case c_kdf
    solve( Session( ~id.1, $A, 'S', ~x.1, $B, pc, rk, ck.1 ) ▶₁ #a )
      case OuterRatchetToSender_case_1
      solve( !KU( kdf(<'ck', 
                       kdf(<'rk', kdf(<'rk', kdf(<'g'^(~ltk*~prek), z.1, z.2>)>), z.3>)>)
             ) @ #vk.2 )
        case c_kdf
        solve( !KU( kdf(<'rk', 
                         kdf(<'rk', kdf(<'g'^(~ltk*~prek), z.1, z.2>)>), z.3>)
               ) @ #vk.8 )
          case c_kdf
          solve( !KU( kdf(<'rk', kdf(<'g'^(~ltk*~prek), z.1, z.2>)>)
                 ) @ #vk.12 )
            case c_kdf
            solve( !KU( kdf(<'g'^(~ltk*~prek), z.1, z.2>) ) @ #vk.16 )
              case c_kdf
              solve( splitEqs(0) )
                case split_case_1
                by contradiction /* from formulas */
              next
                case split_case_2
                by contradiction /* from formulas */
              next
                case split_case_3
                by contradiction /* from formulas */
              next
                case split_case_4
                by contradiction /* from formulas */
              next
                case split_case_5
                by contradiction /* from formulas */
              next
                case split_case_6
                by contradiction /* from formulas */
              next
                case split_case_7
                by contradiction /* from formulas */
              qed
            qed
          qed
        qed
      qed
    next
      case OuterRatchetToSender_case_2
      solve( !KU( kdf(<'ck', kdf(<'rk', old_rk, z.1>)>) ) @ #vk.2 )
        case c_kdf
        solve( !KU( kdf(<'rk', old_rk, z.1>) ) @ #vk.6 )
          case c_kdf
          solve( splitEqs(0) )
            case split_case_1
            by contradiction /* from formulas */
          next
            case split_case_2
            by contradiction /* from formulas */
          next
            case split_case_3
            by contradiction /* from formulas */
          next
            case split_case_4
            by contradiction /* from formulas */
          next
            case split_case_5
            by contradiction /* from formulas */
          next
            case split_case_6
            by contradiction /* from formulas */
          next
            case split_case_7
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case OuterRatchetToSender_case_3
      solve( !KU( kdf(<'ck', kdf(<'rk', kdf(<'rk', old_rk, z.1>), z.2>)>)
             ) @ #vk.2 )
        case c_kdf
        solve( !KU( kdf(<'rk', kdf(<'rk', old_rk, z.1>), z.2>) ) @ #vk.8 )
          case c_kdf
          solve( !KU( kdf(<'rk', old_rk, z.1>) ) @ #vk.12 )
            case c_kdf
            solve( splitEqs(0) )
              case split_case_1
              by contradiction /* from formulas */
            next
              case split_case_2
              by contradiction /* from formulas */
            next
              case split_case_3
              by contradiction /* from formulas */
            next
              case split_case_4
              by contradiction /* from formulas */
            next
              case split_case_5
              by contradiction /* from formulas */
            next
              case split_case_6
              by contradiction /* from formulas */
            next
              case split_case_7
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case Send
      solve( !KU( kdf(<'ck', ck.2>) ) @ #vk.2 )
        case c_kdf
        search for cycle
        cut( ∀ #x. (!KU( z.1 ) @ #x) ⇒ ⊥ )
          case cut
          by contradiction /* cyclic backlink to CS id 4-00 */
        next
          case negate_0
          solve( splitEqs(0) )
            case split_case_1
            by contradiction /* from formulas */
          next
            case split_case_2
            by contradiction /* from formulas */
          next
            case split_case_3
            by contradiction /* from formulas */
          next
            case split_case_4
            by contradiction /* from formulas */
          next
            case split_case_5
            by contradiction /* from formulas */
          next
            case split_case_6
            by contradiction /* from formulas */
          next
            case split_case_7
            by contradiction /* from formulas */
          qed
        qed
      qed
    next
      case SenderStart
      solve( !KU( kdf(<'ck', 
                       kdf(<'rk', 
                            kdf(<'g'^(~ltk*~prek.2), 'g'^(~ltk.1*~x.2), 'g'^(~prek.2*~x.2)>)>)
                      >)
             ) @ #vk.2 )
        case c_kdf
        solve( !KU( kdf(<'rk', 
                         kdf(<'g'^(~ltk*~prek.2), 'g'^(~ltk.1*~x.2), 'g'^(~prek.2*~x.2)>)>)
               ) @ #vk.5 )
          case c_kdf
          solve( !KU( kdf(<'g'^(~ltk*~prek.2), 'g'^(~ltk.1*~x.2), 
                           'g'^(~prek.2*~x.2)>)
                 ) @ #vk.8 )
            case c_kdf
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  qed
qed

lemma Secrecy:
  "All id m pc1 pc2 ss #t. Send(id, m, pc1, pc2, ss) @ #t
    ==>   (not Ex #x. K(m) @ #x)
        | (Ex #x. Reveal(pc1) @ #x)
        | (Ex #x. Reveal(pc2) @ #x)
        | (not Ex #x. GenEph(pc2) @ #x)"

end
